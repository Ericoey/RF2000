+  const uint64_t slow=finish_jog(before_slow);
+  CHECK(sim.step_count[1]-before_slow>=75 && sim.step_count[1]-before_slow<=77,
+    "0.50mm F10 jog emitted%u steps",sim.step_count[1]-before_slow);
