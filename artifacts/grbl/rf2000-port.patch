+    "$2=1\n","$4=1\n","$5=1\n","$21=0\n","$22=1\n","$20=1\n","$32=1\n",
+    "M3\n","M4\n","M7\n","M8\n","M62 P0\n","M64 P0\n","M67 E0 Q1\n",
+    "$112=235\n"};
