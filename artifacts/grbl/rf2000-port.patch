+  fresh(0);
+  assert(DDRC == (uint8_t)~(bit(PC2)|bit(PC0)|bit(PC6)));
+  assert(DDRH == (uint8_t)~bit(PH1));
+  assert(PORTC == (bit(PC2)|bit(PC0)|bit(PC6)) && PORTH == bit(PH1));
+  assert(SREG == 0x80 && OCR2A == 249 && TIMSK2 == bit(OCIE2A));
