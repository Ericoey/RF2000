+    "$27=10\n","$101=1\n","$111=1000\n","$3=0\n","$21=0\n","$N0=G0Y1\n"};
+  for (unsigned i=0;i<sizeof(frozen)/sizeof(*frozen);++i) assert_error(frozen[i]);
