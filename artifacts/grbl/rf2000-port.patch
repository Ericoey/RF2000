+  press(KEY_OK); press(KEY_DOWN); press(KEY_DOWN); press(KEY_OK); press(KEY_OK); run_us(200000);
+  CHECK(display_has("Arbeitsnull setzen?"),"local work-zero confirmation missing:\n%s",display_text());
